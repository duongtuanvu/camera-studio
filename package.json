{
  "name": "camera-studio",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 0.0.0.0",
    "build": "npm run test:coverage && node scripts/prepare-assets.mjs && npm run test:ocr && npm run test:barcode && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/core/camera.ts' --test-coverage-include='src/core/ocr-quality.mjs' --test-coverage-include='src/core/pixels.mjs' --test-coverage-include='src/core/tracker.mjs' --test-coverage-include='src/core/upstream-results.mjs' --test-coverage-include='src/core/document-ocr.mjs' --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=85 --test tests/*.test.mjs",
    "test:ocr": "node scripts/ocr-smoke.mjs",
    "test:barcode": "node scripts/barcode-smoke.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "^0.21.3",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "onnxruntime-web": "1.20.1",
    "zxing-wasm": "3.1.7",
    "@paddleocr/paddleocr-js": "0.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@playwright/test": "^1.55.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
